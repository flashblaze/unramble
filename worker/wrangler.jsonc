{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unramble",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  // Served only on the custom domain (change or remove `routes` for your own zone; with no routes,
  // set "workers_dev": true to get https://unramble.<subdomain>.workers.dev instead).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "unramble.flashblaze.dev", "custom_domain": true }],
  "ai": { "binding": "AI", "remote": true },
  // Strict per-credential quota (src/quota.ts): caps damage if APP_TOKEN leaks (it ships in the APK).
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "Quota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Quota"] }],
  "secrets": {
    // APP_TOKEN: bearer token the watch sends. TICKTICK_TOKEN: from `bun run auth`.
    "required": ["APP_TOKEN", "TICKTICK_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
